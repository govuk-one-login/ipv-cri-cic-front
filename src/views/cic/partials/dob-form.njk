{# src/views/cic/partials/dob-form.njk #}

{% from "frontend-ui/build/components/form/macro.njk" import form %}
{% from "frontend-ui/build/components/date/macro.njk" import date %}
{% from "frontend-ui/build/components/submit/macro.njk" import submit %}

{% set legendContent = translate("dateOfBirth.formLegend") %}
{% set hintText = translate("dateOfBirth.hintText") %}
{% set formInstructions = "<p class=\"govuk-hint\">" + hintText + "</p>" %}

{% call form(ctx) %}

  {{ date(ctx, {
    id: "dateOfBirth",
    namePrefix: "dateOfBirth",
    fieldset: {
      legend: {
        text: legendContent,
        isPageHeading: true,
        classes: "govuk-fieldset__legend--l"
      }
    },
    hint: { html: formInstructions }
  }) }}

  {{ submit(ctx, {
    classes: "govuk-!-margin-top-0",
    attributes: {
      "data-testid": "enter-dob-continue-btn",
      "data-prevent-double-click": "true",
      "data-nav": true,
      "data-link": nextLink
    },
    text: translate("buttons.next")
  }) }}

{% endcall %}
