{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.19.0/schemas/schema.json",
  "services": [
    {
      "product": "Claimed-Identity-Collector-CRI",
      "component": "ipv-cri-cic-front",
      "promotionType": "securePipelines",
      "automated": [
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "secret scanning"
            }
          ],
          "file": ".github/workflows/pre-commit.yml",
          "path": "$.jobs.pre-commit"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-checks.steps[?@.run=='yarn lint']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "unit",
              "purpose": [
                "regression"
              ]
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-checks.steps[?@.run=='yarn test:coverage']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "integration",
              "purpose": [
                "regression"
              ]
            },
            {
              "name": "accessibility"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.run-checks.steps[?@.run=='yarn test:browser:ci']"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code style and linting"
            },
            {
              "name": "unit"
            },
            {
              "name": "unit test coverage"
            }
          ],
          "file": ".github/workflows/pre-merge-checks.yml",
          "path": "$.jobs.sonar-checks"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "code quality"
            }
          ],
          "file": ".github/workflows/codeql.yml",
          "path": "$.jobs.analyze"
        },
        {
          "phase": "pre-merge",
          "provider": "GitHub",
          "checks": [
            {
              "name": "vulnerability detection"
            }
          ],
          "file": ".github/dependabot.yml"
        }
      ]
    }
  ]
}
